---
// La cabecera de un listado: dónde estás, antetítulo, título y entradilla.
// Lleva también las migas para los buscadores (BreadcrumbList).
interface Props {
  migas: { texto: string; href: string }[];
  antetitulo: string;
  titulo: string;
}
const { migas, antetitulo, titulo } = Astro.props;
const SITIO = 'https://www.moloka.es';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: migas.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.texto,
    item: new URL(m.href, SITIO).href,
  })),
};
---
<section class="caja cabeza-listado">
  <nav aria-label="Dónde estás" class="migas">
    {migas.map((m, i) => i < migas.length - 1
      ? <><a href={m.href}>{m.texto}</a><span aria-hidden="true">/</span></>
      : <span aria-current="page" class="aqui">{m.texto}</span>)}
  </nav>
  <p class="mono antetitulo">{antetitulo}</p>
  <h1 class="dis">{titulo}</h1>
  <div class="entradilla"><slot /></div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>

<style>
  .cabeza-listado { padding-top: 14px; padding-bottom: 8px; }
  .migas { display: flex; flex-wrap: wrap; gap: 4px 10px; font-size: 16px; color: var(--tinta-2); }
  .migas a, .migas span { padding: 10px 0; }
  .aqui { font-weight: 700; }
  .antetitulo { margin: 14px 0 0; font-size: 14px; font-weight: 700; letter-spacing: .14em; color: var(--morado); }
  h1 { margin: 10px 0 0; font-size: clamp(30px, 3.8vw, 52px); line-height: 1.06; font-weight: 900; overflow-wrap: break-word; }
  .entradilla { margin-top: 16px; max-width: 820px; font-size: 18px; line-height: 1.55; color: var(--tinta-2); }
  .entradilla :global(p) { margin: 0; }
  @media (max-width: 760px) {
    .entradilla { font-size: 17px; }
  }
</style>
