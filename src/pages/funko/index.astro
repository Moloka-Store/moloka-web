---
// «Funko»: todas las piezas del catálogo que están hoy en el almacén (hoy, todas
// Funko Pop). Primero lo raro, después lo demás.
// Las piezas salen de src/lib/catalogo.js: aquí no se escribe ningún dato a mano.
import Cromos from '../../layouts/Cromos.astro';
import CabezaListado from '../../components/cromos/CabezaListado.astro';
import Listado from '../../components/cromos/Listado.astro';
import { paraListado } from '../../lib/catalogo.js';

const piezas = paraListado();
const raras = piezas.filter((p) => p.esChase).length;
---
<Cromos
  title="Funko Pop en el almacén: chase y los de siempre | MOLOKA"
  description={`Los ${piezas.length} Funko Pop que tenemos hoy en el almacén, ${raras} de ellos chase. Cada cromo dice su número, su precio y qué día llega. Filtra por licencia o busca por número.`}
>
  <div class="claro">
    <CabezaListado
      migas={[{ texto: 'Inicio', href: '/' }, { texto: 'Funko', href: '/funko' }]}
      antetitulo="FUNKO · EN EL ALMACÉN"
      titulo="Funko Pop en el almacén"
    >
      <p>Los Funko Pop que tenemos hoy en el almacén. Primero lo raro, con su marco dorado; después, los de siempre. Cada cromo dice su número, su precio y qué día llega. Filtra por licencia o busca por nombre o por número.</p>
    </CabezaListado>
    <Listado piezas={piezas} filtroRaro />
  </div>
</Cromos>

<style>
  .claro { background: var(--claro); color: var(--tinta); }
</style>
