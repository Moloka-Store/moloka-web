---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Lista todas las guías, la más reciente primero.
const guias = (await getCollection('guias'))
  .sort((a, b) => new Date(b.data.fecha).getTime() - new Date(a.data.fecha).getTime());
---

<Base
  title="Guías Funko: rarezas, CHASE y coleccionismo | Moloka Store"
  description="Guías de coleccionismo Funko de Moloka Store: qué son las rarezas CHASE, Vaulted y exclusivas, cómo saber si un Funko es original y más. Aprende a coleccionar como un experto."
>
  <main class="wrap funko-page">
    <div class="sec-head">
      <h1>Guías Funko <span class="spark">&#10022;</span>
        <span class="sub">Aprende a coleccionar como un experto</span>
      </h1>
    </div>

    {guias.length > 0
      ? <div class="grid-guias">
          {guias.map((g) => (
            <a class="guia-card" href={`/guias/${g.slug}`}>
              <h2>{g.data.title}</h2>
              <p>{g.data.resumen || g.data.description}</p>
              <span class="leer">Leer guía &#8594;</span>
            </a>
          ))}
        </div>
      : <p class="vacio" style="color:var(--ink-soft);padding:30px 0">Estamos preparando las primeras guías. Vuelve pronto.</p>}
  </main>

  <style>
    .grid-guias{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:6px}
    .guia-card{display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);
      border-radius:18px;padding:26px 24px;text-decoration:none;transition:.18s}
    .guia-card:hover{border-color:var(--n2);transform:translateY(-2px);box-shadow:0 14px 30px -18px rgba(124,58,237,.4)}
    .guia-card h2{font-family:'Space Grotesk';font-weight:600;font-size:19px;line-height:1.3;color:var(--ink);margin:0 0 10px}
    .guia-card p{color:var(--ink-soft);font-size:14.5px;line-height:1.6;margin:0 0 16px;flex:1}
    .guia-card .leer{color:var(--n2);font-weight:600;font-size:14px}
    @media(max-width:640px){.grid-guias{grid-template-columns:1fr}}
  </style>
</Base>
