---
// «La Cámara»: los cromos raros que están hoy en el almacén (hoy, los chase).
// Las piezas salen de src/lib/catalogo.js: aquí no se escribe ningún dato a mano.
import Cromos from '../layouts/Cromos.astro';
import CabezaListado from '../components/cromos/CabezaListado.astro';
import Listado from '../components/cromos/Listado.astro';
import { paraListado } from '../lib/catalogo.js';

const piezas = paraListado({ soloRaras: true });
---
<Cromos
  title="La Cámara: Funko Pop chase en el almacén | MOLOKA"
  description={`La Cámara: los ${piezas.length} Funko Pop chase que tenemos hoy en el almacén. Cada cromo dice su número, su precio y qué día llega. Busca por nombre o por número.`}
>
  <div class="claro">
    <CabezaListado
      migas={[{ texto: 'Inicio', href: '/' }, { texto: 'La Cámara', href: '/la-camara' }]}
      antetitulo="FUNKO CHASE · EN EL ALMACÉN"
      titulo="La Cámara"
    >
      <p>Los chase que tenemos hoy en el almacén, con su marco dorado. Cada cromo dice su número, su precio y qué día llega; por detrás, su serie y su rareza. Filtra por licencia o busca por nombre o por número.</p>
    </CabezaListado>
    <Listado piezas={piezas} />
  </div>
</Cromos>

<style>
  .claro { background: var(--claro); color: var(--tinta); }
</style>
